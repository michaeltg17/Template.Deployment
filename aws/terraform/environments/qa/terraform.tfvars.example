# Copy to terraform.tfvars (gitignored) and adjust as needed.
# Only values that differ from the variable defaults need to be listed.
#
# Secrets live in AWS, not GitHub: the values below are pushed into Secrets
# Manager (the DB login + image API key) and SSM Parameter Store (the image
# API URL) by the secrets module. The pods read them at runtime via External
# Secrets Operator; the CD workflow reads the SSM parameter + RDS describe and
# never sees the password or key. The ONLY per-env GitHub value is the
# AWS_ROLE_ARN_<env> repo VARIABLE (terraform output -raw cd_role_arn).

# aws_region  = "us-east-1"
# aws_profile = ""
# project_name = "template"
# environment  = "qa"

# RDS master password. Stored in the template-<env>-db-master secret (and,
# when db_app_username is empty, in template-<env>-db - the login the app uses).
db_master_password = "change-me"

# Image API for this environment (the service is not live yet - random values
# are fine; update the SSM parameter / secret when it is).
image_api_key = "change-me-image-api-key"
image_api_url = "https://image-api.example.invalid"

# Dedicated app login (prod only). Leave empty for dev/qa: the app then
# connects as the RDS master user. For prod set both and run
# bootstrap/provision-db-user.sh <env> after setup-eks.sh to create the role.
# db_app_username = "app"
# db_app_password = "change-me-app-password"

# Cost knobs (defaults are the cheap-dev profile: 1 x m7i-flex.large node):
# worker_instance_types = ["m7i-flex.large"]  # smallest type this account's Free Tier allows for EKS
# worker_desired_size   = 3                   # HA profile: one node per AZ
# worker_min_size       = 3
# db_instance_class     = "db.t4g.micro"
# db_multi_az           = true
