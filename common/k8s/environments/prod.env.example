# per-environment, non-secret values. One file per env (dev.env, qa.env, prod.env).
# Copy to prod.env and fill in:  cp prod.env.example prod.env
# prod.env is gitignored.
#
# AWS path: the DB password + image API key live in AWS Secrets Manager and are
# synced into the cluster by External Secrets Operator - there is NO
# prod.secrets.env on AWS. Only the non-secret values below are needed.
#
# PROD: the CD workflow pins the image tags to the built <sha7> (never `latest`).

ENV=prod
# Server-side base URL the React pod fetches (SSR prefetch + /api proxy).
# In-cluster service URL - must be reachable FROM the pods. Browsers use the
# relative /api path through the ALB, so the public URL never reaches them.
API_URL=http://api:80/api
# base URL of the image API this env's Template.Api calls (required API setting).
# On AWS this is read from SSM Parameter Store (template/prod/image-api-url) by
# the CD workflow and written here; locally, set it by hand.
IMAGE_API_URL=
# DB private endpoint:  terraform output -raw rds_endpoint
RDS_ENDPOINT=
# DB username:          terraform output -raw db_user (the dedicated app login)
DB_USER=

# image tags - pinned by the CD workflow to the built <sha7> (never latest on prod)
API_IMAGE_TAG=latest
REACT_IMAGE_TAG=latest
MIGRATIONS_IMAGE_TAG=latest
